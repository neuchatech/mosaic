# AI provider selected when the composer is set to Automatic.
# Options: codex, local, openrouter
MOSAIC_AI_PROVIDER=codex

# Codex CLI (uses the user's local Codex login; no API key is stored here).
MOSAIC_CODEX_MODEL=gpt-5.6-luna

# Local OpenAI-compatible server (LM Studio default shown).
# Start the server, load a tool-capable model, then set its exact model id.
MOSAIC_LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
MOSAIC_LOCAL_AI_MODEL=
# Set to 1 only when the loaded local model accepts OpenAI-compatible image_url input.
MOSAIC_LOCAL_AI_VISION=0
# MOSAIC_LOCAL_AI_API_KEY=

# OpenRouter can be connected from AI settings with PKCE. Environment values
# are optional overrides for managed installs and take priority over UI values.
OPENROUTER_API_KEY=
MOSAIC_OPENROUTER_MODEL=
# Optional override for environment-managed vision models. UI-selected models are detected automatically.
MOSAIC_OPENROUTER_VISION=0
# MOSAIC_OPENROUTER_SITE_URL=https://github.com/your-name/mosaic
MOSAIC_OPENROUTER_APP_NAME=Neuchatech MosAIc
