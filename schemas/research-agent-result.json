{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neuchatech MosAIc research agent result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "outcome", "title", "message", "itemIds", "collectionIds", "artifactIds", "filters", "evidence", "warnings", "followUps", "metrics"],
  "properties": {
    "version": { "const": 1 },
    "outcome": { "enum": ["completed", "partial", "needs_input", "blocked"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "itemIds": { "type": "array", "maxItems": 500, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "collectionIds": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "artifactIds": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "filters": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "filter"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "filter": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "description", "where", "limit"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "where": { "$ref": "#/$defs/filterExpression" },
              "sort": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "direction"],
                "properties": {
                  "field": { "type": "string", "minLength": 1 },
                  "direction": { "enum": ["asc", "desc"] }
                }
              },
              "limit": { "type": "integer", "minimum": 1, "maximum": 5000 }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "note", "url"],
        "properties": {
          "kind": { "enum": ["item", "collection", "source", "image", "fact", "warning"] },
          "id": { "type": "string", "maxLength": 500 },
          "note": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "url": { "type": ["string", "null"], "format": "uri", "maxLength": 2000 }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "followUps": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCalls", "itemsRead", "imagesInspected", "acquiredItems"],
      "properties": {
        "toolCalls": { "type": "integer", "minimum": 0 },
        "itemsRead": { "type": "integer", "minimum": 0 },
        "imagesInspected": { "type": "integer", "minimum": 0 },
        "acquiredItems": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "filterExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "field", "operator", "value"],
          "properties": {
            "type": { "const": "clause" },
            "field": { "type": "string", "minLength": 1 },
            "operator": { "enum": ["eq", "neq", "contains", "not_contains", "in", "not_in", "gte", "lte", "between", "exists", "missing"] },
            "value": {
              "oneOf": [
                { "type": "string" },
                { "type": "number" },
                { "type": "boolean" },
                { "type": "null" },
                { "type": "array", "items": { "type": "string" } },
                { "type": "array", "items": { "type": "number" } }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "conjunction", "children"],
          "properties": {
            "type": { "const": "group" },
            "conjunction": { "enum": ["and", "or"] },
            "children": { "type": "array", "items": { "$ref": "#/$defs/filterExpression" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "child"],
          "properties": {
            "type": { "const": "not" },
            "child": { "$ref": "#/$defs/filterExpression" }
          }
        }
      ]
    }
  }
}
