{
  "id": "earth-tones-wide",
  "name": "Tons terre, volumes larges",
  "description": "Exemple de filtre imbriqué et modifiable par Codex.",
  "where": {
    "type": "group",
    "conjunction": "and",
    "children": [
      {
        "type": "group",
        "conjunction": "or",
        "children": [
          { "type": "clause", "field": "colorFamily", "operator": "in", "value": ["brown", "beige", "green", "blue"] },
          { "type": "clause", "field": "tags", "operator": "contains", "value": "earth-tone" }
        ]
      },
      {
        "type": "group",
        "conjunction": "or",
        "children": [
          { "type": "clause", "field": "fit", "operator": "in", "value": ["wide", "relaxed", "cropped"] },
          { "type": "clause", "field": "kind", "operator": "eq", "value": "reference" }
        ]
      },
      {
        "type": "not",
        "child": { "type": "clause", "field": "tags", "operator": "contains", "value": "sportswear" }
      },
      { "type": "clause", "field": "price", "operator": "lte", "value": 180 }
    ]
  },
  "sort": { "field": "scores.style_match", "direction": "desc" },
  "limit": 500
}
